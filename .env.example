PORT=0
KINDLING_DB_MODE=
CHAT_WAPP_PIPELINE_NAME=chat-wapp-agent-response
CHAT_WAPP_PUBLIC_ORIGIN=
WINGMAN_URL=
WEBHOOK_SECRET=
WAPP_OWNER_NPUB=
WAPP_ALLOWED_NPUBS_JSON=[]

# Canonical company authority. The managed app card should inject the public URL.
KINDLING_API_URL=http://127.0.0.1:41038
# A cache is current only after a successful authorized sync within this age.
KINDLING_CACHE_MAX_AGE_MS=900000
# Explicit compatibility escape hatch for isolated legacy tests/debugging only.
KINDLING_COMPANY_SOURCE=canonical-api

# Optional Tower-backed local workflow runtime. Autopilot injects this
# installation-scoped broker contract; never configure a raw signing key here.
WAPP_DB_MODE=
WAPP_APP_NPUB=
WAPP_TOWER_DB_BROKER_URL=
WAPP_TOWER_DB_CAPABILITY=
